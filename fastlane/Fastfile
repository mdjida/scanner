default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight (requires signing certificates via match)"
  lane :beta do
    match(type: "appstore", readonly: is_ci)
    increment_build_number(xcodeproj: "LiveCompOverlay.xcodeproj")
    build_app(
      project: "LiveCompOverlay.xcodeproj",
      scheme: "LiveCompOverlay",
      export_method: "app-store",
      include_bitcode: false,
      include_symbols: true,
      output_directory: "build",
      output_name: "LiveCompOverlay.ipa"
    )
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "Build an ad-hoc IPA for direct device install (requires signing certificates via match)"
  lane :adhoc do
    match(type: "adhoc", readonly: is_ci)
    build_app(
      project: "LiveCompOverlay.xcodeproj",
      scheme: "LiveCompOverlay",
      export_method: "ad-hoc",
      output_directory: "build",
      output_name: "LiveCompOverlay-adhoc.ipa"
    )
  end
end
